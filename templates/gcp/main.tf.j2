# Auto-generated Terraform — {{ app_name }} (GCP)
# Generated by AI Infrastructure Agent

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
  }

  backend "gcs" {
    bucket = "{{ app_name }}-tf-state"
    prefix = "{{ app_name }}/terraform/state"
  }
}

variable "project_id" {
  description = "GCP project ID (also read from GOOGLE_PROJECT env var in CI)"
  type        = string
}

provider "google" {
  project = var.project_id
  region  = "{{ region }}"
}

{% if has_vpc %}
# ── VPC ──────────────────────────────────────────────────────────────
resource "google_compute_network" "main" {
  name                    = "{{ app_name }}-vpc"
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "public" {
  name          = "{{ app_name }}-public-subnet"
  ip_cidr_range = "10.0.1.0/24"
  region        = "{{ region }}"
  network       = google_compute_network.main.id
}
{% endif %}

{% if has_computeengine %}
# ── Compute Engine ──────────────────────────────────────────────────
resource "google_compute_instance" "app" {
  name         = "{{ app_name }}-vm"
  machine_type = "{{ vm_size }}"
  zone         = "{{ region }}-a"

  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
    }
  }

  network_interface {
    {% if has_vpc %}
    network    = google_compute_network.main.id
    subnetwork = google_compute_subnetwork.public.id
    {% else %}
    network = "default"
    {% endif %}
    access_config {} # ephemeral public IP
  }

  labels = {
    project    = "{{ app_name }}"
    managed_by = "terraform"
  }
}

output "compute_instance_ip" {
  value       = google_compute_instance.app.network_interface[0].access_config[0].nat_ip
  description = "Public IP of the Compute Engine instance"
}
{% endif %}

{% if has_cloudstorage %}
# ── Cloud Storage ────────────────────────────────────────────────────
resource "random_id" "suffix" {
  byte_length = 4
}

resource "google_storage_bucket" "app" {
  name                        = "{{ app_name }}-storage-${random_id.suffix.hex}"
  location                    = "{{ region }}"
  uniform_bucket_level_access = true
  versioning {
    enabled = true
  }
  labels = { project = "{{ app_name }}" }
}

output "storage_bucket_name" {
  value       = google_storage_bucket.app.name
  description = "Name of the Cloud Storage bucket"
}
{% endif %}

{% if has_cloudsql %}
# ── Cloud SQL ────────────────────────────────────────────────────────
resource "google_sql_database_instance" "app" {
  name             = "{{ app_name }}-db"
  database_version = "MYSQL_8_0"
  region           = "{{ region }}"

  settings {
    tier = "db-f1-micro"
  }

  deletion_protection = false
}

resource "google_sql_user" "app" {
  name     = "admin"
  instance = google_sql_database_instance.app.name
  password = "changeme123!" # change this before deploying to production
}

output "cloudsql_connection_name" {
  value       = google_sql_database_instance.app.connection_name
  description = "Cloud SQL connection name"
}
{% endif %}

{% if has_cloudfunctions %}
# ── Cloud Functions ──────────────────────────────────────────────────
resource "google_storage_bucket" "func_source" {
  name                        = "{{ app_name }}-func-source-${random_id.suffix.hex}"
  location                    = "{{ region }}"
  uniform_bucket_level_access = true
}

resource "google_cloudfunctions2_function" "app" {
  name     = "{{ app_name }}-function"
  location = "{{ region }}"

  build_config {
    runtime     = "python312"
    entry_point = "main"
    source {
      storage_source {
        bucket = google_storage_bucket.func_source.name
        object = "function-source.zip" # upload your source zip separately
      }
    }
  }

  service_config {
    max_instance_count = 1
    available_memory    = "256M"
  }

  labels = { project = "{{ app_name }}" }
}

output "function_url" {
  value       = google_cloudfunctions2_function.app.url
  description = "URL of the Cloud Function"
}
{% endif %}

{% if has_gke %}
# ── GKE ──────────────────────────────────────────────────────────────
resource "google_container_cluster" "main" {
  name     = "{{ app_name }}-gke"
  location = "{{ region }}-a"

  remove_default_node_pool = true
  initial_node_count       = 1

  {% if has_vpc %}
  network    = google_compute_network.main.id
  subnetwork = google_compute_subnetwork.public.id
  {% endif %}
}

resource "google_container_node_pool" "primary" {
  name       = "{{ app_name }}-node-pool"
  cluster    = google_container_cluster.main.name
  location   = "{{ region }}-a"
  node_count = 1

  node_config {
    machine_type = "e2-medium"
    labels       = { project = "{{ app_name }}" }
  }
}

output "gke_endpoint" {
  value       = google_container_cluster.main.endpoint
  description = "GKE cluster API endpoint"
  sensitive   = true
}
{% endif %}

{% if has_cloudmonitoring %}
# ── Cloud Monitoring ─────────────────────────────────────────────────
resource "google_monitoring_notification_channel" "app" {
  display_name = "{{ app_name }}-alerts"
  type         = "email"
  labels = {
    email_address = "alerts@example.com" # replace with your real address
  }
}
{% endif %}

{% if has_iam %}
# ── IAM ───────────────────────────────────────────────────────────────
resource "google_service_account" "app" {
  account_id   = "{{ app_name }}-svc"
  display_name = "{{ app_name }} service account"
}
{% endif %}
