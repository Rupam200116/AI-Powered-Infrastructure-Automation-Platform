# Auto-generated Terraform — {{ app_name }} (Azure)
# Generated by AI Infrastructure Agent

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    {% if has_rbac %}
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 2.0"
    }
    {% endif %}
  }

  backend "azurerm" {
    resource_group_name  = "{{ app_name }}-tfstate-rg"
    storage_account_name = "{{ app_name | replace('-','') }}tfstate"
    container_name       = "tfstate"
    key                  = "{{ app_name }}.terraform.tfstate"
  }
}

provider "azurerm" {
  features {}
}

{% if has_rbac %}
provider "azuread" {}
{% endif %}

resource "azurerm_resource_group" "main" {
  name     = "{{ app_name }}-rg"
  location = "{{ region }}"
  tags = {
    Project   = "{{ app_name }}"
    ManagedBy = "terraform"
  }
}

{% if has_vnet or has_vm %}
# ── Virtual Network ─────────────────────────────────────────────────
# (created automatically whenever a VM is selected, since Azure VMs
#  cannot exist without a subnet — even if VNet wasn't explicitly picked)
resource "azurerm_virtual_network" "main" {
  name                = "{{ app_name }}-vnet"
  address_space       = ["10.0.0.0/16"]
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  tags = { Project = "{{ app_name }}" }
}

resource "azurerm_subnet" "public" {
  name                 = "{{ app_name }}-public-subnet"
  resource_group_name  = azurerm_resource_group.main.name
  virtual_network_name = azurerm_virtual_network.main.name
  address_prefixes     = ["10.0.1.0/24"]
}
{% endif %}

{% if has_vm %}
# ── Virtual Machine ─────────────────────────────────────────────────
resource "azurerm_public_ip" "app" {
  name                = "{{ app_name }}-pip"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "app" {
  name                = "{{ app_name }}-nic"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.public.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.app.id
  }
}

resource "tls_private_key" "app_ssh" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "azurerm_linux_virtual_machine" "app" {
  name                = "{{ app_name }}-vm"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  size                = "{{ vm_size }}"
  admin_username      = "azureuser"

  network_interface_ids = [azurerm_network_interface.app.id]

  admin_ssh_key {
    username   = "azureuser"
    public_key = tls_private_key.app_ssh.public_key_openssh
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-jammy"
    sku       = "22_04-lts"
    version   = "latest"
  }

  tags = { Project = "{{ app_name }}" }
}

output "vm_ssh_private_key" {
  value       = tls_private_key.app_ssh.private_key_pem
  description = "Private key to SSH into the VM — retrieve with: terraform output -raw vm_ssh_private_key > key.pem"
  sensitive   = true
}

output "vm_public_ip" {
  value       = azurerm_public_ip.app.ip_address
  description = "Public IP of the virtual machine"
}
{% endif %}

{% if has_blob %}
# ── Blob Storage ─────────────────────────────────────────────────────
resource "random_id" "suffix" {
  byte_length = 4
}

resource "azurerm_storage_account" "app" {
  name                     = "{{ app_name | replace('-','') }}${random_id.suffix.hex}"
  resource_group_name      = azurerm_resource_group.main.name
  location                 = azurerm_resource_group.main.location
  account_tier             = "Standard"
  account_replication_type = "LRS"
  tags = { Project = "{{ app_name }}" }
}

resource "azurerm_storage_container" "app" {
  name                  = "{{ app_name }}-container"
  storage_account_name  = azurerm_storage_account.app.name
  container_access_type = "private"
}

output "storage_account_name" {
  value       = azurerm_storage_account.app.name
  description = "Name of the storage account"
}
{% endif %}

{% if has_sqldb %}
# ── Azure SQL Database ─────────────────────────────────────────────────
resource "azurerm_mssql_server" "app" {
  name                         = "{{ app_name }}-sqlserver"
  resource_group_name          = azurerm_resource_group.main.name
  location                     = azurerm_resource_group.main.location
  version                      = "12.0"
  administrator_login          = "sqladmin"
  administrator_login_password = "ChangeMe123!" # change this before deploying to production
  tags = { Project = "{{ app_name }}" }
}

resource "azurerm_mssql_database" "app" {
  name       = "{{ app_name | replace('-','') }}db"
  server_id  = azurerm_mssql_server.app.id
  sku_name   = "Basic"
  tags = { Project = "{{ app_name }}" }
}

output "sql_server_fqdn" {
  value       = azurerm_mssql_server.app.fully_qualified_domain_name
  description = "Azure SQL server connection endpoint"
}
{% endif %}

{% if has_function %}
# ── Azure Functions ──────────────────────────────────────────────────
resource "azurerm_service_plan" "app" {
  name                = "{{ app_name }}-plan"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  os_type             = "Linux"
  sku_name            = "Y1"
}

resource "azurerm_storage_account" "func" {
  name                     = "{{ app_name | replace('-','') }}func"
  resource_group_name      = azurerm_resource_group.main.name
  location                 = azurerm_resource_group.main.location
  account_tier             = "Standard"
  account_replication_type = "LRS"
}

resource "azurerm_linux_function_app" "app" {
  name                       = "{{ app_name }}-function"
  resource_group_name       = azurerm_resource_group.main.name
  location                  = azurerm_resource_group.main.location
  service_plan_id           = azurerm_service_plan.app.id
  storage_account_name      = azurerm_storage_account.func.name
  storage_account_access_key = azurerm_storage_account.func.primary_access_key

  site_config {}
  tags = { Project = "{{ app_name }}" }
}

output "function_app_url" {
  value       = azurerm_linux_function_app.app.default_hostname
  description = "URL of the Function App"
}
{% endif %}

{% if has_aks %}
# ── AKS ──────────────────────────────────────────────────────────────
resource "azurerm_kubernetes_cluster" "main" {
  name                = "{{ app_name }}-aks"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  dns_prefix          = "{{ app_name }}"

  default_node_pool {
    name       = "default"
    node_count = 1
    vm_size    = "Standard_DS2_v2"
  }

  identity {
    type = "SystemAssigned"
  }

  tags = { Project = "{{ app_name }}" }
}

output "aks_host" {
  value       = azurerm_kubernetes_cluster.main.kube_config.0.host
  description = "AKS cluster API endpoint"
  sensitive   = true
}
{% endif %}

{% if has_monitor %}
# ── Monitor ──────────────────────────────────────────────────────────
resource "azurerm_log_analytics_workspace" "app" {
  name                = "{{ app_name }}-logs"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  sku                 = "PerGB2018"
  retention_in_days   = 7
  tags = { Project = "{{ app_name }}" }
}
{% endif %}

{% if has_rbac %}
# ── RBAC / Entra ID ──────────────────────────────────────────────────
resource "azuread_application" "app" {
  display_name = "{{ app_name }}-service-app"
}

resource "azuread_service_principal" "app" {
  client_id = azuread_application.app.client_id
}
{% endif %}
