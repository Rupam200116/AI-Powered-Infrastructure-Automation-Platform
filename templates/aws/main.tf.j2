# Auto-generated Terraform — {{ app_name }}
# Generated by AI Infrastructure Agent

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    bucket         = "{{ app_name }}-tf-state"
    key            = "{{ app_name }}/terraform.tfstate"
    region         = "{{ region }}"
    dynamodb_table = "{{ app_name }}-tf-lock"
  }
}

provider "aws" {
  region = "{{ region }}"

  default_tags {
    tags = {
      Project   = "{{ app_name }}"
      ManagedBy = "terraform"
    }
  }
}

{% if has_vpc %}
# ── VPC ──────────────────────────────────────────────────────────
resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = { Name = "{{ app_name }}-vpc" }
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "{{ region }}a"
  map_public_ip_on_launch = true
  tags = { Name = "{{ app_name }}-public-subnet" }
}

resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id
  tags   = { Name = "{{ app_name }}-igw" }
}
{% endif %}

{% if has_ec2 %}
# ── EC2 ───────────────────────────────────────────────────────────
resource "aws_instance" "app" {
  ami           = "ami-0f58b397bc5c1f2e8"  # Amazon Linux 2 — Mumbai
  instance_type = "{{ instance_type }}"

  {% if has_vpc %}
  subnet_id = aws_subnet.public.id
  {% endif %}

  tags = { Name = "{{ app_name }}-server" }
}

output "ec2_public_ip" {
  value       = aws_instance.app.public_ip
  description = "Public IP of the EC2 instance"
}
{% endif %}

{% if has_s3 %}
# ── S3 ────────────────────────────────────────────────────────────
resource "random_id" "suffix" {
  byte_length = 4
}

resource "aws_s3_bucket" "app_bucket" {
  bucket = "{{ app_name }}-storage-${random_id.suffix.hex}"
  tags   = { Name = "{{ app_name }}-bucket" }
}

resource "aws_s3_bucket_versioning" "versioning" {
  bucket = aws_s3_bucket.app_bucket.id
  versioning_configuration {
    status = "Enabled"
  }
}

output "s3_bucket_name" {
  value       = aws_s3_bucket.app_bucket.bucket
  description = "Name of the S3 bucket"
}
{% endif %}

{% if has_rds %}
# ── RDS ───────────────────────────────────────────────────────────
resource "aws_db_instance" "database" {
  identifier        = "{{ app_name }}-db"
  engine            = "mysql"
  engine_version    = "8.0"
  instance_class    = "db.t3.micro"
  allocated_storage = 20
  storage_type      = "gp2"

  db_name  = replace("{{ app_name }}", "-", "")
  username = "admin"
  password = "changeme123!"  # change this before deploying to production

  skip_final_snapshot = true
  tags = { Name = "{{ app_name }}-database" }
}

output "rds_endpoint" {
  value       = aws_db_instance.database.endpoint
  description = "RDS MySQL connection endpoint"
}
{% endif %}

{% if has_lambda %}
# ── Lambda ────────────────────────────────────────────────────────
resource "aws_iam_role" "lambda_role" {
  name = "{{ app_name }}-lambda-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

resource "aws_lambda_function" "app" {
  function_name = "{{ app_name }}-function"
  role          = aws_iam_role.lambda_role.arn
  handler       = "index.handler"
  runtime       = "python3.12"
  filename      = "lambda.zip"

  tags = { Name = "{{ app_name }}-lambda" }
}

output "lambda_arn" {
  value       = aws_lambda_function.app.arn
  description = "ARN of the Lambda function"
}
{% endif %}

{% if has_eks %}
# ── EKS ───────────────────────────────────────────────────────────
resource "aws_iam_role" "eks_role" {
  name = "{{ app_name }}-eks-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "eks.amazonaws.com" }
    }]
  })
}

resource "aws_eks_cluster" "main" {
  name     = "{{ app_name }}-cluster"
  role_arn = aws_iam_role.eks_role.arn
  version  = "1.29"

  vpc_config {
    subnet_ids = [{% if has_vpc %}aws_subnet.public.id{% else %}"subnet-xxxxxxxx"{% endif %}]
  }

  tags = { Name = "{{ app_name }}-eks" }
}

output "eks_endpoint" {
  value       = aws_eks_cluster.main.endpoint
  description = "EKS cluster API endpoint"
}
{% endif %}

{% if has_cloudwatch %}
# ── CloudWatch ────────────────────────────────────────────────────
resource "aws_cloudwatch_log_group" "app_logs" {
  name              = "/{{ app_name }}/application"
  retention_in_days = 7
  tags = { Name = "{{ app_name }}-logs" }
}
{% endif %}

{% if has_iam %}
# ── IAM ───────────────────────────────────────────────────────────
resource "aws_iam_user" "app_user" {
  name = "{{ app_name }}-service-user"
  tags = { Name = "{{ app_name }}-iam-user" }
}
{% endif %}
